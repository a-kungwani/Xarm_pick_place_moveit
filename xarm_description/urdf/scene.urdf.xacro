<?xml version="1.0"?>
<robot name="world_converted">
  
  <!-- Ground Plane -->
  <!-- <link name="ground">
    <visual>
      <geometry>
        <box size="100 100 0.01"/>
      </geometry>
      <material>
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
