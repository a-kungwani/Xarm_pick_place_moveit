  <!-- Table -->
  <link name="table">
    <visual>
      <geometry>
        <box size="1.5 0.8 0.03"/>
      </geometry>
      <material>
        <color rgba="0.6 0.3 0.1 1"/>
      </material>
    </visual>
  </link>

  <!-- Table Legs -->
  <link name="table_leg_1">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="1"/>
      </geometry>
      <material>
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
  </link>
  <joint name="table_leg_1_joint" type="fixed">
    <parent link="table"/>
    <child link="table_leg_1"/>
    <origin xyz="0.68 0.38 -0.5"/>
  </joint>

  <!-- Cube -->
  <link name="cube">
    <visual>
      <geometry>
        <box size="0.05 0.1 0.1"/>
      </geometry>
      <material>
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>
  <joint name="cube_fixed" type="fixed">
    <parent link="table"/>
    <child link="cube"/>
    <origin xyz="0 0.8 0.065"/>
  </joint>

</robot>

